@model CertAI.Manager.Models.VceQuestion
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Assistant</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #000;
            color: #fff;
            overflow: hidden;
            font-family: sans-serif;
        }

        #btnMic {
            width: 90px;
            height: 90px;
            border-radius: 50%;
            border: 3px solid #222;
            background: #111;
            color: #555;
            transition: all 0.2s;
        }

        .listening {
            border-color: #ff4b2b !important;
            color: #ff4b2b !important;
            box-shadow: 0 0 20px #ff4b2b;
            transform: scale(1.1);
        }

        .res-letra {
            font-size: 11rem;
            line-height: 1;
            color: #00ff9d;
            font-weight: 900;
        }

        .res-texto {
            font-size: 1.6rem;
            color: #ddd;
        }

        .status-msg {
            font-size: 0.8rem;
            color: #444;
            height: 20px;
        }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center vh-100">

    <div class="container text-center">
        <div id="status" class="status-msg mb-2 text-success fw-bold">CONECTADO - IA ACTIVADA (DB: @(Model?.Id?.Substring(0,8)))</div>

        <div class="row align-items-center mb-4">
            <div class="col-12"><div id="letra" class="res-letra">--</div></div>
            <div id="contenedorPregunta" class="col-12">
                <div id="explicacion" class="res-texto">
                    <span class="text-white">@(Model?.Text ?? "Toca el micro y lee la pregunta")</span>
                    @if (!string.IsNullOrEmpty(Model?.TextEn))
                    {
                        <br /><small class="text-info opacity-50" style="font-size: 1.1rem;">@Model.TextEn</small>
                    }
                </div>
            </div>
        </div>

        <div id="listaOpciones" class="mt-4 text-start d-inline-block" style="width: 100%; max-width: 600px;">
            @if (Model?.VceOptions != null)
            {
                foreach (var opt in Model.VceOptions)
                {
                    <div class="p-2 mb-2 border rounded border-secondary option-item">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span>○ @opt.Text</span>
                                @if (!string.IsNullOrEmpty(opt.TextEn))
                                {
                                    <br /><small class="text-info opacity-50 ms-3">@opt.TextEn</small>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <div class="mt-4">
            <button id="btnMic" onclick="toggleSpeech()">
                <svg id="micIcon" xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M3.5 6.5A.5.5 0 0 1 4 7v1a4 4 0 0 0 8 0V7a.5.5 0 0 1 1 0v1a5 5 0 0 1-4.5 4.975V15h3a.5.5 0 0 1 0 1h-7a.5.5 0 0 1 0-1h3v-2.025A5 5 0 0 1 3 8V7a.5.5 0 0 1 .5-.5z" />
                    <path d="M10 8a2 2 0 1 0-4 0V3a2 2 0 1 0 4 0v5zM8 0a3 3 0 0 1 3 3v5a3 3 0 0 1-6 0V3a3 3 0 0 1 3-3z" />
                </svg>
            </button>
        </div>
    </div>

    <script>
        console.log("%c CARGADO - Versión con Logs de Depuración ", "background: #222; color: #bada55; font-size: 20px;");
        let isListening = false;
        const recognition = new (window.SpeechRecognition || window.webkitSpeechRecognition)();
        recognition.lang = 'es-MX';
        recognition.continuous = true;
        recognition.interimResults = true;
        recognition.maxAlternatives = 1;

         function toggleSpeech() {
            if (isListening) {
                recognition.stop();
            } else {
                // LIMPIEZA TOTAL PARA NUEVA PREGUNTA
                document.getElementById('letra').innerText = "...";
                document.getElementById('explicacion').innerHTML = "Escuchando...";
                document.getElementById('listaOpciones').innerHTML = "";
                document.getElementById('status').innerText = ""; 
                
                try {
                    recognition.start();
                } catch (e) {
                    console.error("Error al iniciar:", e);
                }
            }
        }

        recognition.onstart = () => {
            isListening = true;
            document.getElementById('btnMic').classList.add('listening');
            document.getElementById('status').innerText = "ESCUCHANDO...";
        };

        let silenceTimer;

         recognition.onresult = (event) => {
            clearTimeout(silenceTimer);

            let interimTranscript = '';
            for (let i = event.resultIndex; i < event.results.length; ++i) {
                if (event.results[i].isFinal) {
                    const finalQuery = event.results[i][0].transcript;
                    silenceTimer = setTimeout(() => {
                        document.getElementById('status').innerText = "PROCESANDO...";
                        getAIResponse(finalQuery);
                        recognition.stop();
                    }, 1500); // 1.5s de silencio es suficiente

                } else {
                    interimTranscript += event.results[i][0].transcript;
                    document.getElementById('status').innerText = "VOZ: " + interimTranscript;
                }
            }
        };

        recognition.onend = () => {
            isListening = false;
            document.getElementById('btnMic').classList.remove('listening');
        };

        recognition.onerror = (event) => {
            isListening = false;
            document.getElementById('btnMic').classList.remove('listening');
            
            if (event.error === 'no-speech') {
                document.getElementById('status').innerText = "NO SE DETECTÓ VOZ";
                document.getElementById('explicacion').innerText = "No te escuché. Pulsa el micro e intenta de nuevo.";
            } else {
                document.getElementById('status').innerText = "ERROR MIC: " + event.error;
                document.getElementById('explicacion').innerText = "Hubo un problema con el micrófono.";
            }
            
            if (document.getElementById('letra').innerText === "...") {
                document.getElementById('letra').innerText = "--";
            }
        };

        async function getAIResponse(query) {
            const listaUI = document.getElementById('listaOpciones');
            const letraUI = document.getElementById('letra');
            const explicacionUI = document.getElementById('explicacion');

            console.log("Iniciando petición al servidor con query:", query);

            try {
                const response = await fetch('/Trainer/ProcesarPregunta', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        pregunta: query,
                        opciones: []
                    })
                });

                const data = await response.json();
                console.log("Datos recibidos del servidor:", data);

                if (data.letra) {
                    letraUI.innerText = data.letra;
                    
                    if (data.letra === "!") {
                        explicacionUI.innerHTML = `<span class="text-danger">ERROR: ${data.detalle || 'Error desconocido'}</span>`;
                        return;
                    }

                    // Renderizamos la pregunta bilingüe
                    explicacionUI.innerHTML = `<span class="text-white">${data.preguntaTexto}</span>`;
                    if (data.preguntaEn) {
                        explicacionUI.innerHTML += `<br/><small class="text-info opacity-50" style="font-size: 1.1rem;">${data.preguntaEn}</small>`;
                    }

                    listaUI.innerHTML = "";
                    if (data.todasLasOpciones && data.todasLasOpciones.length > 0) {
                        data.todasLasOpciones.forEach(opt => {
                            const textoEs = opt.es || opt;
                            const textoEn = opt.en || "";
                            
                            // Coincidencia para marcar correcta
                            const esCorrecta = data.opcionCorrectaTexto && (
                                             textoEs.toLowerCase().includes(data.opcionCorrectaTexto.toLowerCase()) || 
                                             data.opcionCorrectaTexto.toLowerCase().includes(textoEs.toLowerCase()) ||
                                             (textoEn && textoEn.toLowerCase().includes(data.opcionCorrectaTexto.toLowerCase())));
                            
                            const div = document.createElement('div');
                            div.className = "p-2 mb-2 border rounded option-item " + (esCorrecta ? "border-success text-success fw-bold" : "border-secondary");
                            
                            let html = `<div><span>${esCorrecta ? "● " : "○ "} ${textoEs}</span>`;
                            if (textoEn) {
                                html += `<br/><small class="text-info opacity-50 ms-3">${textoEn}</small>`;
                            }
                            html += `</div>`;
                            
                            div.innerHTML = html;
                            listaUI.appendChild(div);
                        });
                    }
                    
                    document.getElementById('status').innerText = "TERMINADO - " + data.fuente;
                }
            } catch (error) {
                console.error("Error fetch:", error);
                document.getElementById('status').innerText = "ERROR DE SERVIDOR";
            }
        }
    </script>
</body>
</html>